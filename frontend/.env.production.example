# -------------------------------------------------------------
# FLASH RENT - PRODUCTION ENVIRONMENT VARIABLES
# -------------------------------------------------------------
# Salin file ini menjadi `.env.production` dan isi nilai sebenarnya
# sebelum menjalankan `npm run build` untuk server produksi.
# -------------------------------------------------------------

# Ganti dengan URL Cloud Functions Firebase Production Anda
VITE_API_URL=https://us-central1-flash-rent-production.cloudfunctions.net/api

# Ganti dengan konfigurasi Firebase Production Anda (didapat dari Firebase Console)
VITE_FIREBASE_API_KEY=your_production_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=flash-rent-production.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=flash-rent-production
VITE_FIREBASE_STORAGE_BUCKET=flash-rent-production.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Nonaktifkan mode simulasi saat di production
VITE_USE_MOCK_DATA=false
