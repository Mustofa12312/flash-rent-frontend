rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function untuk cek apakah user yang login adalah admin
    // Implementasi riil bisa dicek dari custom claims token.isAdmin atau tabel khusus admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email.matches('.*@flashrent[.]com');
    }
    
    // Helper function untuk cek apakah user sudah login
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function untuk cek kepemilikan data (ownership)
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // 1. Koleksi Produk & Paket (Public Read, Admin Write)
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /packages/{packageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Koleksi Customer / User (Owner Read/Write, Admin Read/Write)
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // 3. Koleksi Transaksi & Hak Akses
    // - Orders: Owner boleh baca, dilarang edit sembarangan (kecuali backend)
    // - Rentals: Owner boleh baca
    // - Accesses (Data Sensitif): Owner boleh baca
    match /orders/{orderId} {
      // Customer boleh baca ordernya sendiri (asumsi data order menyimpan field userId)
      allow read: if isOwner(resource.data.userId) || isAdmin();
      
      // Mengizinkan penambahan order (create) dari guest sebelum auth di tahap pembayaran,
      // asalkan field userId diisi (bisa berupa guest-id/anon-id)
      allow create: if true; 
      allow update, delete: if isAdmin();
    }
    
    match /payments/{paymentId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /rentals/{rentalId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if isAdmin(); // Hanya Cloud Functions (Backend) yang boleh mengelola rental
    }

    match /accesses/{accessId} {
      // Data sangat sensitif! Hanya bisa dibaca oleh pemilik sah dan sistem backend
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow write: if isAdmin();
    }
    
    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow update: if isOwner(resource.data.userId); // Untuk 'mark as read'
      allow create, delete: if isAdmin();
    }
  }
}
