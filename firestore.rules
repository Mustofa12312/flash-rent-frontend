rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Fungsi bantuan untuk mengecek apakah user login
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Fungsi bantuan untuk mengecek apakah user adalah ADMIN
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    // 1. Aturan untuk koleksi users
    match /users/{userId} {
      // User bisa membaca datanya sendiri. Admin bisa baca semua.
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      // Saat mendaftar (create), user hanya boleh mendaftar dengan role CUSTOMER
      allow create: if isAuthenticated() && (request.auth.uid == userId && request.resource.data.role == 'CUSTOMER');

      // Saat update, user TIDAK boleh mengubah field 'role' mereka sendiri. Admin bebas.
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (request.auth.uid == userId && request.resource.data.role == resource.data.role)
      );
      
      allow delete: if isAdmin();
    }

    // 2. Aturan untuk koleksi orders
    match /orders/{orderId} {
      // User bisa melihat pesanannya sendiri. Admin bisa melihat semua pesanan.
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      
      // User HANYA boleh membuat pesanan dengan status 'PENDING'.
      // Admin boleh melakukan operasi create/update/delete apapun.
      allow create: if isAuthenticated() && (
        isAdmin() || (request.resource.data.userId == request.auth.uid && request.resource.data.status == 'PENDING')
      );
      
      // Hanya Admin yang boleh mengubah pesanan yang sudah ada (Misal ubah jadi PAID).
      allow update, delete: if isAdmin();
    }

    // 3. Aturan untuk koleksi rentals (Barang digital / Lisensi)
    match /rentals/{rentalId} {
      // User bisa melihat lisensinya sendiri. Admin bisa melihat semuanya.
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      
      // HANYA Admin yang boleh membuat atau mengubah data rental.
      // (Ini mencegah user membuat lisensi gratis untuk mereka sendiri).
      allow write: if isAdmin();
    }
    
    // Aturan untuk Promos
    match /promos/{promoId} {
      // Siapapun bisa membaca (untuk validasi kode promo saat checkout)
      allow read: if true;
      // Hanya Admin yang bisa menambah, mengubah, atau menghapus promo
      allow write: if isAdmin();
    }

    // Aturan untuk Settings
    match /settings/{settingId} {
      // Siapapun bisa membaca pengaturan aplikasi dasar
      allow read: if true;
      // Hanya Admin yang bisa mengubah pengaturan
      allow write: if isAdmin();
    }
    
    // 4. Aturan untuk koleksi products (Katalog Barang)
    match /products/{productId} {
      // Semua pengunjung (bahkan yang belum login) bisa melihat produk
      allow read: if true;
      
      // HANYA Admin yang boleh menambah/mengubah/menghapus produk
      allow write: if isAdmin();
    }
    
    // Fallback: Tolak semua akses yang tidak secara spesifik diizinkan di atas
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
