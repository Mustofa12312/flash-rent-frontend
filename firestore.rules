rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Fungsi bantuan untuk mengecek apakah user login
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Fungsi bantuan untuk mengecek apakah user adalah ADMIN
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    // 1. Aturan untuk koleksi users
    match /users/{userId} {
      // User bisa membaca dan mengedit datanya sendiri. Admin bisa baca/tulis semua.
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // 2. Aturan untuk koleksi orders
    match /orders/{orderId} {
      // User bisa melihat pesanannya sendiri. Admin bisa melihat semua pesanan.
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      
      // User HANYA boleh membuat pesanan dengan status 'PENDING'.
      // Admin boleh melakukan operasi create/update/delete apapun.
      allow create: if isAuthenticated() && (
        isAdmin() || (request.resource.data.userId == request.auth.uid && request.resource.data.status == 'PENDING')
      );
      
      // Hanya Admin yang boleh mengubah pesanan yang sudah ada (Misal ubah jadi PAID).
      allow update, delete: if isAdmin();
    }

    // 3. Aturan untuk koleksi rentals (Barang digital / Lisensi)
    match /rentals/{rentalId} {
      // User bisa melihat lisensinya sendiri. Admin bisa melihat semuanya.
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      
      // HANYA Admin yang boleh membuat atau mengubah data rental.
      // (Ini mencegah user membuat lisensi gratis untuk mereka sendiri).
      allow write: if isAdmin();
    }
    
    // Fallback: Tolak semua akses yang tidak secara spesifik diizinkan di atas
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
